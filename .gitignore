#  Secrets, never commit
# ─────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
# Anchored to root so it doesn't match terraform/modules/secrets/
/secrets/
credentials.json
service-account*.json

