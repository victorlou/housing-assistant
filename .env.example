# Copy to `.env` and fill in real values (`.env` is gitignored).
#   cp .env.example .env        # Unix
#   Copy-Item .env.example .env # PowerShell
#
# Terraform + Databricks providers do not read this file by themselves.
# Load into your shell when needed; see docs/runbook.md.
#
# Optional: if you standardise on a single config root for tooling (see docs/runbook.md).
# CONFIG_PATH=/absolute/path/to/config

# Profile name from: databricks auth login --profile <name>  (~/.databrickscfg)
DATABRICKS_CONFIG_PROFILE=your-databricks-profile

# Optional: CI-style auth instead of profile
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=

# Optional: only if your task needs AWS (S3, etc.)
# AWS_PROFILE=

# LINZ Data Service API key (see .devnotes/linz-lds-apis.md)
LINZ_API_KEY=your-linz-api-key
